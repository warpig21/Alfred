# Alfred — self-hosted AppFlowy Cloud configuration
# Copy this file to `.env` before building:  cp dev.env .env
#
# APPFLOWY_CLOUD_URL : URL of your self-hosted AppFlowy Cloud backend
# AUTHENTICATOR_TYPE : 0 = local, 2 = AppFlowy Cloud (beta), 3 = self-host, 4 = develop
APPFLOWY_CLOUD_URL=https://sync.mattiasantarelli.com
AUTHENTICATOR_TYPE=3
